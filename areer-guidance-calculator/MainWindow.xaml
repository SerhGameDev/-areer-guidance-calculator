<Window x:Class="MyCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мой калькулятор"
        Width="420"
        Height="650"
        MinWidth="350"
        MinHeight="550"
        Background="#202124"
        WindowStyle="ToolWindow">

    <Window.Resources>

        <!-- Обычная кнопка -->
        <Style x:Key="CalculatorButton" TargetType="Button">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#303134"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Кнопка математической операции -->
        <Style x:Key="OperationButton"
               TargetType="Button"
               BasedOn="{StaticResource CalculatorButton}">
            <Setter Property="Background" Value="#8AB4F8"/>
            <Setter Property="Foreground" Value="#202124"/>
        </Style>

        <!-- Кнопка равно -->
        <Style x:Key="EqualsButton"
               TargetType="Button"
               BasedOn="{StaticResource CalculatorButton}">
            <Setter Property="Background" Value="#A8DAB5"/>
            <Setter Property="Foreground" Value="#202124"/>
        </Style>

    </Window.Resources>


    <Grid Margin="15">

        <!-- Строки -->
        <Grid.RowDefinitions>
            <RowDefinition Height="1.4*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Столбцы -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ЭКРАН -->

        <Border Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                Background="#292A2D"
                CornerRadius="15"
                Margin="5">

            <TextBlock x:Name="Display"
                       Text="0"
                       Foreground="White"
                       FontSize="48"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="20"/>
        </Border>


        <!-- C -->

        <Button Grid.Row="1"
                Grid.Column="0"
                Content="C"
                Style="{StaticResource CalculatorButton}"
                Click="Clear_Click"/>


        <!-- КНОПКА СООБЩЕНИЯ -->

        <Button Grid.Row="1"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Content="!"
                Style="{StaticResource CalculatorButton}"
                Click="Message_Click"/>


        <!-- ДЕЛЕНИЕ -->

        <Button Grid.Row="1"
                Grid.Column="3"
                Content="÷"
                Style="{StaticResource OperationButton}"
                Click="Operation_Click"/>


        <!-- 7 8 9 × -->

        <Button Grid.Row="2"
                Grid.Column="0"
                Content="7"
                Style="{StaticResource CalculatorButton}"
                Click="Number_Click"/>

        <Button Grid.Row="2"
                Grid.Column="1"
                Content="8"
                Style="{StaticResource CalculatorButton}"
                Click="Number_Click"/>

        <Button Grid.Row="2"
                Grid.Column="2"
                Content="9"
                Style="{StaticResource CalculatorButton}"
                Click="Number_Click"/>

        <Button Grid.Row="2"
                Grid.Column="3"
                Content="×"
                Style="{StaticResource OperationButton}"
                Click="Operation_Click"/>


        <!-- 4 5 6 − -->

        <Button Grid.Row="3"
                Grid.Column="0"
                Content="4"
                Style="{StaticResource CalculatorButton}"
                Click="Number_Click"/>

        <Button Grid.Row="3"
                Grid.Column="1"
                Content="5"
                Style="{StaticResource CalculatorButton}"
                Click="Number_Click"/>

        <Button Grid.Row="3"
                Grid.Column="2"
                Content="6"
                Style="{StaticResource CalculatorButton}"
                Click="Number_Click"/>

        <Button Grid.Row="3"
                Grid.Column="3"
                Content="−"
                Style="{StaticResource OperationButton}"
                Click="Operation_Click"/>


        <!-- 1 2 3 + -->

        <Button Grid.Row="4"
                Grid.Column="0"
                Content="1"
                Style="{StaticResource CalculatorButton}"
                Click="Number_Click"/>

        <Button Grid.Row="4"
                Grid.Column="1"
                Content="2"
                Style="{StaticResource CalculatorButton}"
                Click="Number_Click"/>

        <Button Grid.Row="4"
                Grid.Column="2"
                Content="3"
                Style="{StaticResource CalculatorButton}"
                Click="Number_Click"/>

        <Button Grid.Row="4"
                Grid.Column="3"
                Content="+"
                Style="{StaticResource OperationButton}"
                Click="Operation_Click"/>


        <!-- 0 . = -->

        <Button Grid.Row="5"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Content="0"
                Style="{StaticResource CalculatorButton}"
                Click="Number_Click"/>

        <Button Grid.Row="5"
                Grid.Column="2"
                Content="."
                Style="{StaticResource CalculatorButton}"
                Click="Decimal_Click"/>

        <Button Grid.Row="5"
                Grid.Column="3"
                Content="="
                Style="{StaticResource EqualsButton}"
                Click="Equals_Click"/>

    </Grid>

</Window>