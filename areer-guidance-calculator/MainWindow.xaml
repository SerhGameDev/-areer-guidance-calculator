<Window x:Class="Lesson5_WPF_Template.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Моё приложение"
        Width="500"
        Height="600"
        WindowStyle="ToolWindow">

    <!--
        ============================================================
        ПАМЯТКА
        ============================================================

        Этот файл отвечает ЗА ВНЕШНИЙ ВИД приложения.

        Здесь мы создаём:
        - окно;
        - сетки (Grid);
        - кнопки (Button);
        - текст (TextBlock);
        - поля (TextBox);
        - другие элементы интерфейса.

        C# сюда писать НЕ НУЖНО.

        Если нужно изменить внешний вид приложения — работаем здесь.
    -->

    <!-- ==========================================================
         НАСТРОЙКИ ОКНА

         Попробуйте изменить:
         Title   — название окна
         Width   — ширину
         Height  — высоту
         WindowStyle — внешний вид рамки окна
         Background — цвет фона
         ========================================================== -->


    <!-- ==========================================================
         ОСНОВНАЯ СЕТКА ПРИЛОЖЕНИЯ

         Grid — это сетка, в которой мы размещаем элементы.

         Сначала можно создать строки:

         <Grid.RowDefinitions>
             <RowDefinition />
             <RowDefinition />
         </Grid.RowDefinitions>

         Затем столбцы:

         <Grid.ColumnDefinitions>
             <ColumnDefinition />
             <ColumnDefinition />
         </Grid.ColumnDefinitions>

         ========================================================== -->

    <Grid Margin="15">

        <!--
            ЗДЕСЬ СОЗДАЙТЕ СТРОКИ GRID.

            Например:

            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
        -->

        <!--
            ЗДЕСЬ СОЗДАЙТЕ СТОЛБЦЫ GRID.

            Например:

            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
        -->

        <!-- ======================================================
             ЗДЕСЬ СОЗДАЮТСЯ ЭЛЕМЕНТЫ ИНТЕРФЕЙСА
             ======================================================

             Например, кнопка:

             <Button Content="7"
                     Width="80"
                     Height="60" />

             Если кнопка должна находиться в конкретной ячейке:

             <Button Grid.Row="1"
                     Grid.Column="0"
                     Content="7" />

             ВАЖНО:
             Grid.Row и Grid.Column начинают считать с НУЛЯ.

             Первая строка  = Row 0
             Вторая строка  = Row 1
             Первый столбец = Column 0
             Второй столбец = Column 1
        -->


        <!-- ЗДЕСЬ БУДЕТ ВАШ ИНТЕРФЕЙС -->




        <!--
            ПРИМЕР ТЕКСТА:

            <TextBlock Text="Привет!"
                       FontSize="30" />

            ПРИМЕР ПОЛЯ:

            <TextBox x:Name="MyTextBox"
                     Text="Введите текст" />

            x:Name даёт элементу имя.
            По этому имени к нему можно обратиться из C#.
        -->

    </Grid>

</Window>
